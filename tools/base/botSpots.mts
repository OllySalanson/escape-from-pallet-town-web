/**
 * Writes `src/game/base/generated/harbourBotSpots.ts`: where the harbour's
 * regulars may stand about (`base/harbourBots.ts`, `searchLoiterSpots`).
 * Re-run after the yard, its doors or its people change; `harbourBots.test.ts`
 * fails until it is.
 *
 *   npx vite-node tools/base/botSpots.mts
 */
import { writeFileSync } from 'node:fs';
import { searchLoiterSpots } from '../../src/game/base/harbourBots';

const spots = searchLoiterSpots();
const rows = spots.map((spot) => `  [${spot.x}, ${spot.y}],`).join('\n');
writeFileSync(
  new URL('../../src/game/base/generated/harbourBotSpots.ts', import.meta.url),
  `// Generated by tools/base/botSpots.mts from the yard (\`searchLoiterSpots\`).\n// Do not edit: re-run the tool.\n\n/** Where the harbour's regulars stand about, as [x, y]. */\nexport const LOITER_SPOTS: readonly (readonly [number, number])[] = [\n${rows}\n];\n`,
);
console.log(`${spots.length} loiter spots written.`);
